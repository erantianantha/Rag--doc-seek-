# ─── Embeddings (uses Gemini REST API directly) ──────────────────────────────
# Get free at: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# ─── Chat LLM (uses OpenRouter free tier) ────────────────────────────────────
# Get free at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ─── CORS — Frontend URL (set this on Render after deploying frontend) ────────
FRONTEND_URL=http://localhost:3000

# ─── Server Port (Render sets this automatically) ────────────────────────────
PORT=3001
